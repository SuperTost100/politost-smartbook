{
  "name": "politost-smartbook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs --strict && node scripts/generate-headers.mjs",
    "build": "tsc -b && vite build",
    "postinstall": "node scripts/copy-pyodide.mjs && node scripts/generate-headers.mjs",
    "prepare:e2e": "playwright install chromium",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:politost": "scripts/deploy-politost.sh",
    "validate:chapter": "tsx scripts/validate-chapter.ts",
    "pack:ptsb": "tsx scripts/pack-ptsb.ts",
    "test:unit": "tsx --test src/lib/*.test.ts",
    "test:security": "tsx --test src/lib/sanitizeHtml.test.ts",
    "test:content": "npm run test --prefix packages/content-core && tsx --test src/lib/safeMathExpr.test.ts src/lib/ptsb.test.ts src/lib/consentVersion.test.ts",
    "test:print": "npm run prepare:e2e && playwright test e2e/print.spec.ts",
    "test:e2e": "npm run prepare:e2e && playwright test",
    "test:e2e:ui": "npm run prepare:e2e && playwright test --ui",
    "test:mobile": "npm run prepare:e2e && playwright test e2e/mobile.spec.ts --project=mobile",
    "tokens": "node design-system/tokens/build.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@politost/content-core": "file:packages/content-core",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^6.7.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "markdown-it": "^15.0.3",
    "monaco-editor": "^0.57.0",
    "numbl": "0.4.22",
    "plotly.js": "4.3.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^4.1.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "minimatch": "^11.0.4"
  },
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
