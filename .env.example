# All optional. The standalone reader needs no backend.

# Serve the app from a subfolder, e.g. /reader. Default: the site root.
VITE_BASE_PATH=
# Books site that serves catalog.json. Empty: builtin books and uploads only.
VITE_BOOKS_URL=

# Private platform integration.
VITE_PLATFORM_ENABLED=false
VITE_API_URL=

# Optional Google services. Empty values keep all Google requests disabled.
VITE_GA4_ID=
# Approved publisher ID, e.g. ca-pub- followed by 16 digits.
VITE_ADSENSE_CLIENT=
# Enable only after publishing Google's certified European regulations message worldwide.
# See docs/ads-and-analytics.md for required AdSense and GA4 account settings.
VITE_GOOGLE_CMP_ENABLED=false
