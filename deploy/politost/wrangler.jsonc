// The public PoliTost reader at politost.it/reader. Deploy with `npm run deploy:politost`.
// The routes only claim /reader, so the landing page at politost.it/ is a separate project.
{
  "name": "politost-reader",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "politost.it/reader", "zone_name": "politost.it" },
    { "pattern": "politost.it/reader/*", "zone_name": "politost.it" }
  ],
  "assets": {
    // Built by the deploy script: the reader's dist/ under site/reader/, and _headers at the root.
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // These paths get their page from worker.js even though /reader/ is a file (the app's index.html).
    "run_worker_first": ["/reader/", "/reader/libro/*", "/reader/sitemap.xml"]
  },
  "vars": {
    // Where the Worker reads the catalog and the books rendered as HTML.
    "BOOKS_URL": "https://books.politost.it"
  }
}
